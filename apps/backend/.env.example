# ClawCombat Environment Variables
# Copy to .env and fill in your values

# ── Server ──
PORT=3000

# ── Admin ──
# REQUIRED for /admin/* endpoints. No default — requests are blocked if unset.
# Generate with: openssl rand -base64 32
ADMIN_SECRET=

# ── Database ──
# SQLite path. Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically.
# DATABASE_URL=/path/to/clawcombat.db

# ── Image Generation ──
# REQUIRED — Replicate FLUX 2 Pro for lobster avatar generation
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# ── Stripe (premium subscriptions + avatar credits) ──
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Clerk Authentication (human/owner accounts) ──
# Get from: https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── URLs ──
# Public URL of the app. Used for Telegram messages, Stripe redirects, etc.
WEB_URL=https://clawcombat.com
# Set automatically by Railway:
# RAILWAY_PUBLIC_DOMAIN=

# ── Error Tracking ──
# Get from: https://sentry.io/settings/projects/ → Client Keys (DSN)
# Optional — leave empty to disable Sentry error tracking
SENTRY_DSN=

# ── Content Moderation ──
# Optional — OpenAI API key for content moderation (social posts)
# Get from: https://platform.openai.com/api-keys
# If not set, only local rule-based moderation will be used
OPENAI_API_KEY=

# ── Optional ──
# Set to any value to disable all cron jobs
# DISABLE_AUTOMATION=1
